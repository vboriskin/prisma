#!/usr/bin/env bash
# ============================================================
# СБОФ Планирование — запуск двойным кликом (macOS)
#
# Что делает: запускает локальный сервер, открывает приложение
# в вашем браузере. Чтобы остановить — просто закройте это окно.
#
# Как использовать первый раз:
#   1. Двойной клик по этому файлу.
#   2. Если macOS говорит «не удалось проверить разработчика» —
#      правый клик → «Открыть» → «Открыть» в подтверждении.
#      Дальше будет работать обычным двойным кликом.
# ============================================================
set -e

# Перейти в папку, где лежит этот файл — даже если запустили
# из другого места.
cd "$(dirname "$0")"

# Найти node. Сначала PATH, потом стандартные места установки.
NODE_BIN=""
if command -v node >/dev/null 2>&1; then
  NODE_BIN="$(command -v node)"
elif [ -x "/usr/local/bin/node" ]; then
  NODE_BIN="/usr/local/bin/node"
elif [ -x "/opt/homebrew/bin/node" ]; then
  NODE_BIN="/opt/homebrew/bin/node"
fi

if [ -z "$NODE_BIN" ]; then
  echo ""
  echo "  ❌ Не найден Node.js"
  echo ""
  echo "  Установите его одним из способов:"
  echo "    1. Скачать с https://nodejs.org (LTS-версия)"
  echo "    2. Через Homebrew:   brew install node"
  echo ""
  echo "  После установки запустите этот файл снова."
  echo ""
  echo "  (Это окно останется открытым, чтобы вы видели сообщение.)"
  read -n 1 -s -r -p "  Нажмите любую клавишу чтобы закрыть…"
  echo ""
  exit 1
fi

clear
echo "======================================"
echo "  СБОФ Планирование v11"
echo "======================================"
echo ""

exec "$NODE_BIN" launch.js
