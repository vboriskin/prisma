@echo off
REM ============================================================
REM  СБОФ Планирование — запуск двойным кликом (Windows)
REM
REM  Что делает: поднимает локальный сервер, открывает приложение
REM  в браузере. Чтобы остановить — закройте это окно.
REM
REM  Как использовать первый раз:
REM    1. Двойной клик по файлу.
REM    2. Если Windows SmartScreen ругается — «Подробнее» →
REM       «Выполнить в любом случае».
REM ============================================================
chcp 65001 > nul
setlocal

REM Перейти в папку, где лежит этот .bat
cd /d "%~dp0"

REM Проверить наличие Node
where node >nul 2>&1
if errorlevel 1 (
  echo.
  echo   [X] Не найден Node.js
  echo.
  echo   Скачайте и установите LTS-версию с https://nodejs.org
  echo   После установки откройте этот файл снова.
  echo.
  pause
  exit /b 1
)

cls
echo ======================================
echo   СБОФ Планирование v11
echo ======================================
echo.

node launch.js

REM Если node вышел сам, не закрывать окно сразу — пользователь
REM должен увидеть сообщение об ошибке если она была.
if errorlevel 1 (
  echo.
  pause
)
